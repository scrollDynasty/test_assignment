{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/**",
      "packages/**",
      "Dockerfile",
      "docker-entrypoint.sh",
      ".dockerignore",
      "package.json",
      "package-lock.json",
      "tsconfig*.json",
      "funnel-v*.json",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 15
  }
}
